// Prisma 7 — datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// PostgreSQL only — raw SQL (e.g. FOR UPDATE SKIP LOCKED) is written for Postgres.
datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  active
  inactive
}

enum CallLogStatus {
  in_progress
  answered
  not_answered
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String   @default("Super Admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model State {
  id          Int                   @id @default(autoincrement())
  name        String
  code        String                @unique @db.VarChar(2)
  status      EntityStatus          @default(active)
  areaCodes   AreaCodeMap[]
  dids        Did[]
  assignments UserStateAssignment[]

  @@map("states")
}

model AreaCodeMap {
  id        Int    @id @default(autoincrement())
  areaCode  String @unique @map("area_code") @db.VarChar(3)
  stateId   Int    @map("state_id")
  state     State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@map("area_code_map")
}

model Switch {
  id            Int            @id @default(autoincrement())
  name          String
  switchType    String         @map("switch_type")
  switchUrl     String         @map("switch_url")
  switchPort    Int            @map("switch_port")
  authToken     String         @map("auth_token")
  webhookSecret String         @unique @map("webhook_secret")
  status        EntityStatus   @default(active)
  users         User[]
  callLogs      CallLog[]

  @@map("switches")
}

model User {
  id            Int                   @id @default(autoincrement())
  name          String
  email         String                @unique
  password      String
  switchId      Int?                  @map("switch_id")
  status        EntityStatus          @default(active)
  createdAt     DateTime              @default(now()) @map("created_at")
  switch        Switch?               @relation(fields: [switchId], references: [id])
  apiKeys       ApiKey[]
  dids          Did[]
  assignments   UserStateAssignment[]
  callLogs      CallLog[]

  @@map("users")
}

model UserStateAssignment {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  stateId    Int      @map("state_id")
  didCount   Int      @map("did_count")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state      State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([userId, stateId])
  @@map("user_state_assignments")
}

model ApiKey {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  key        String       @unique
  status     EntityStatus @default(active)
  lastUsedAt DateTime?    @map("last_used_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Did {
  id          Int          @id @default(autoincrement())
  number      String       @unique
  areaCode    String       @map("area_code") @db.VarChar(3)
  stateId     Int          @map("state_id")
  status      EntityStatus @default(active)
  isInUse     Boolean      @default(false) @map("is_in_use")
  assignedTo  Int?         @map("assigned_to")
  assignedAt  DateTime?    @map("assigned_at")
  totalUses   Int          @default(0) @map("total_uses")
  lastUsedAt  DateTime?    @map("last_used_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  state       State        @relation(fields: [stateId], references: [id])
  user        User?        @relation(fields: [assignedTo], references: [id])
  callLogs    CallLog[]

  @@index([stateId, assignedTo, status, isInUse, totalUses])
  @@map("dids")
}

model CallLog {
  id             Int           @id @default(autoincrement())
  userId         Int           @map("user_id")
  didId          Int           @map("did_id")
  switchId       Int           @map("switch_id")
  receiverNumber String        @map("receiver_number")
  receiverState  String        @map("receiver_state") @db.VarChar(2)
  callStatus     CallLogStatus @default(in_progress) @map("call_status")
  duration       Int?
  startedAt      DateTime      @map("started_at")
  endedAt        DateTime?     @map("ended_at")
  user           User          @relation(fields: [userId], references: [id])
  did            Did           @relation(fields: [didId], references: [id])
  switch         Switch        @relation(fields: [switchId], references: [id])

  @@index([userId, startedAt])
  @@index([switchId])
  @@map("call_logs")
}

model SystemSettings {
  id                    Int    @id @default(1)
  systemName            String @default("Local Presence Dialing") @map("system_name")
  lowPoolWarningThreshold Int  @default(5) @map("low_pool_warning_threshold")
  apiRateLimitPerMinute Int    @default(120) @map("api_rate_limit_per_minute")

  @@map("system_settings")
}
