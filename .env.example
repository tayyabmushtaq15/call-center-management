# Copy to .env and adjust.
#
# PostgreSQL ONLY — this app is designed and tested for PostgreSQL. Use a
# postgresql:// or postgres:// URL (managed instance, Docker, etc.).
DATABASE_URL="postgresql://postgres:ha2ris3nade4em2@localhost:5432/localpresence?schema=public"

# Used to sign admin JWT cookies (min 32 random chars in production).
JWT_SECRET="change-me-in-production-use-long-random-string"

# Optional: set true to log switch dispatch payloads in dev.
SWITCH_CLIENT_DEBUG="false"

# Set to 1 to skip real HTTP calls to the VoIP switch (stub SwitchClient).
SWITCH_STUB="0"
