# Copy to .env and adjust.
#
# PostgreSQL ONLY — this app is designed and tested for PostgreSQL. Use a
# postgresql:// or postgres:// URL (managed instance, Docker, etc.).
#
# All tables live in the "callcenter" schema (set in prisma/schema.prisma), so
# the database can be shared with other apps that use "public" — e.g. a single
# Supabase project. ?schema=callcenter makes the Prisma CLI keep its
# _prisma_migrations table there too, instead of mixing with another app's
# history in "public" (the app's pg driver ignores the parameter).
DATABASE_URL="postgresql://postgres:ha2ris3nade4em2@localhost:5432/localpresence?schema=callcenter"

# Optional: connection used by the Prisma CLI (migrations). Leave unset locally.
# On Supabase, DATABASE_URL is the pooled URL (port 6543) and DIRECT_URL the
# session/direct URL (port 5432). Only ever run `npm run db:deploy` against it —
# never `db:migrate` (migrate dev), which can reset the database.
# DATABASE_URL="postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=callcenter"

# Used to sign admin JWT cookies (min 32 random chars in production).
JWT_SECRET="change-me-in-production-use-long-random-string"

# Optional: set true to log switch dispatch payloads in dev.
SWITCH_CLIENT_DEBUG="false"

# Set to 1 to skip real HTTP calls to the VoIP switch (stub SwitchClient).
SWITCH_STUB="0"
